{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "slkops",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "slkops-db",
			"database_id": "03b4217b-032b-4c15-9cc1-266d7f28481b",
			"migrations_dir": "replica/migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "cbc330732d454b138e4dd5fa91ee8af4"
		}
	],
	// attachments and uploaded JRA forms: npx wrangler r2 bucket create slkops-files
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "slkops-files"
		}
	],
	// served at slkops.nesrapp.com (nesrapp.com is a zone in this account)
	"routes": [
		{
			"pattern": "slkops.nesrapp.com",
			"custom_domain": true
		}
	],
	// The live WIREGUARD Worker in the same Cloudflare account. Under `vite dev` the mock in
	// mock-wireguard/ carries the same name and answers instead.
	"services": [
		{
			"binding": "WIREGUARD",
			"service": "slkwireguard-backend"
		}
	],
	"triggers": {
		"crons": [
			"*/15 * * * *",
			"0 1 * * *"
		]
	},
	// Cloudflare Email Service for the morning reconciliation digest. The sender domain (nesrapp.com) must be
	// onboarded first: npx wrangler email sending enable nesrapp.com
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"vars": {
		"APP_URL": "https://slkops.nesrapp.com",
		"IDLE_MINUTES": "60",
		// WIREGUARD runs before this date are history and never reported as unlinked
		"RECON_START_DATE": "2026-10-01",
		"WG_APP_URL": "https://slkwireguard.nesrapp.com",
		"EMAIL_FROM": "slkops@nesrapp.com"
	}
	// secrets (wrangler secret put …, or .dev.vars locally): WG_SYNC_USERNAME, WG_SYNC_PASSWORD, SIGNING_KEY, ANTHROPIC_API_KEY (optional)
}