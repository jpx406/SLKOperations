{
  "name": "slk-operations",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "tokens": "python replica/design/build_tokens.py",
    "db:migrate:local": "wrangler d1 migrations apply slkops-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply slkops-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tanstack/react-query": "^5.104.5",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
